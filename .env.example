# Скопируйте в .env и укажите токен бота. Файл .env в git не попадает.

# Токен чат-бота MAX (платформа MAX для партнёров → Чат-боты → Настройки)
MAX_BOT_TOKEN=your_max_bot_token_here

# Базовый адрес API MAX
MAX_API_BASE_URL=https://platform-api2.max.ru

# Получение событий: polling (по умолчанию) или webhook
BOT_MODE=polling

# Строка подключения к БД (в Docker переопределяется в compose.yaml)
DATABASE_URL=sqlite+aiosqlite:///./data/vsbore.db

# Часовой пояс, в котором хранится и показывается время встреч
TIMEZONE=Europe/Moscow

LOG_LEVEL=INFO
