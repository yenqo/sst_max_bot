# ==========================================
# Конфигурация проекта «В сборе» (MAX Hackathon)
# Скопируйте этот файл в .env и заполните значения
# ВНИМАНИЕ: не коммитьте файл .env в репозиторий!
# ==========================================

# Токен чат-бота MAX (предоставляется организаторами)
MAX_BOT_TOKEN=your_max_bot_token_here

# Базовый адрес API платформы MAX
MAX_API_BASE_URL=https://platform-api2.max.ru

# Режим работы бота (polling / webhook)
BOT_MODE=polling

# Публичный URL для вебхуков (если используется режим webhook)
# WEBHOOK_URL=https://your-domain.com/webhook

# Окружение приложения (development / production)
APP_ENV=development
LOG_LEVEL=INFO

# Серверные параметры (для API / Webhook-сервера)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# База данных
DATABASE_URL=sqlite+aiosqlite:///./data/vsbore.db
# Для PostgreSQL (Docker compose):
# DATABASE_URL=postgresql+asyncpg://vsbore_user:vsbore_password@db:5432/vsbore_db
